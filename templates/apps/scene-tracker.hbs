<div class="litm-scene-tracker">

  <!-- HEADER -->
  <div class="st-hdr">
    <span class="st-scene-name">{{sceneName}}</span>
    <span class="wordmark">Legend in the Mist<br>Scene Tracker</span>
    {{#if isGM}}
    <button type="button" class="st-edit-toggle" data-action="toggleEditMode" title="Toggle edit mode">
      <i class="fa-solid fa-pencil"></i>
    </button>
    {{/if}}
  </div>

  {{#if activeRoll}}
  <div class="st-roll-banner">
    <div class="st-roll-banner-hdr">
      Contributing to <strong>{{activeRoll.actorName}}</strong>'s roll — click to add (click again for positive, again to remove)
    </div>
    {{#if activeRoll.rollTypeLabel}}
    <div class="st-roll-live">
      <span class="st-roll-live-type">{{activeRoll.rollTypeLabel}}</span>
      <span class="st-roll-live-total {{activeRoll.powerClass}}">{{activeRoll.powerLabel}}</span>
      {{#if activeRoll.sacrificeLevel}}
      <span class="st-roll-live-sacrifice">Sacrifice: {{activeRoll.sacrificeLevel}}</span>
      {{/if}}
      {{#if activeRoll.entries.length}}
      <span class="st-roll-live-sep">—</span>
      {{#each activeRoll.entries}}
      <span class="st-roll-live-entry {{#if burned}}burn{{else}}{{#if isPositive}}pos{{else}}neg{{/if}}{{/if}}">{{name}}</span>
      {{/each}}
      {{else}}
      <span class="st-roll-live-empty">no tags selected yet</span>
      {{/if}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  <!-- BODY -->
  <div class="st-body">

    <!-- LEFT: Story Tags + Statuses -->
    <div class="st-left">

      <div class="csec-title">{{localize "LITM.Sheet.StoryTags"}}</div>

      <div class="tags-wrap">
        {{#each storyTags}}
        <span class="tag power ch-tag {{#if scratched}}scratched{{/if}} {{#unless visible}}st-hidden{{/unless}}"
              data-action="scratchStoryTag" data-id="{{id}}"
              data-contrib-id="stag-{{id}}" data-contrib-name="{{name}}" data-contrib-kind="storyTag" data-contrib-source="Scene" data-contrib-tier="">
          <input class="st-tag-inp ch-tag-inp" type="text" data-id="{{id}}"
                 value="{{name}}" placeholder="tag…">
          {{#if ../isGM}}
          <button type="button" class="st-eye-btn edit-only" data-action="toggleTagVisibility" data-id="{{id}}"
                  title="{{#if visible}}Hide from players{{else}}Show to players{{/if}}">
            <i class="fa-solid {{#if visible}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
          </button>
          {{/if}}
        </span>
        {{/each}}
        {{#if isGM}}
        <span class="tag add edit-only" data-action="addStoryTag">+ add tag</span>
        {{/if}}
      </div>

      <div class="csec-title">{{localize "LITM.Sheet.Statuses"}}</div>

      <div class="status-wrap">
        {{#each statuses}}
        <div class="status-row">
          <div class="status-pill" data-status-id="{{id}}"
               data-contrib-id="sstat-{{id}}" data-contrib-name="{{name}}-{{tier}}" data-contrib-kind="status" data-contrib-tier="{{tier}}" data-contrib-source="Scene">
            <input class="sname st-sname" type="text" data-status-id="{{id}}"
                   value="{{name}}" placeholder="Status…">
            <span class="tier-boxes">
              {{#if ../isGM}}
              <button type="button" class="stb st-reduce-btn" data-action="reduceStatus" data-status-id="{{id}}" title="Reduce all tiers by 1"><i class="fa-solid fa-minus"></i></button>
              {{/if}}
              {{#each boxes}}
              <span class="stb {{#if isActive}}active{{else}}{{#if marked}}on{{/if}}{{/if}}"
                    data-action="toggleStatusBox"
                    data-status-id="{{../id}}"
                    data-tier="{{tier}}">{{tier}}</span>
              {{/each}}
            </span>
          </div>
        </div>
        {{/each}}
      </div>

      {{#if isGM}}
      <button type="button" class="chal-add-btn status-add-btn edit-only" data-action="addStatus">+ Add Status</button>
      {{/if}}

      <div class="csec-title">Story Themes</div>

      {{#each storyThemes}}
      <div class="st-story-theme {{#unless visible}}st-hidden{{/unless}}" data-id="{{id}}">
        <div class="st-stheme-hdr">
          <span class="tag power title-tag {{#if titleScratched}}scratched{{/if}}"
                data-action="scratchStoryThemeTitle"
                data-id="{{id}}"
                data-contrib-id="stheme-title-{{id}}"
                data-contrib-name="{{name}}"
                data-contrib-kind="storyThemeTitle"
                data-contrib-source="Scene"
                data-contrib-tier="">
            <input class="st-theme-title-inp" type="text" data-id="{{id}}"
                   value="{{name}}" placeholder="title tag…">
          </span>
          {{#if ../isGM}}
          <div class="st-stheme-actions edit-only">
            <button type="button" class="st-eye-btn"
                    data-action="toggleStoryThemeVisibility" data-id="{{id}}"
                    title="{{#if visible}}Hide from players{{else}}Show to players{{/if}}">
              <i class="fa-solid {{#if visible}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
            </button>
            <button type="button" class="btn-remove"
                    data-action="removeStoryTheme" data-id="{{id}}" title="Remove">✕</button>
          </div>
          {{/if}}
        </div>
        <div class="tags-wrap st-stheme-tags">
          {{#each powerTags}}
          <span class="tag power ch-tag {{#if scratched}}scratched{{/if}}"
                data-action="scratchStoryThemeTag"
                data-id="{{../id}}"
                data-tag-id="{{id}}"
                data-collection="powerTags"
                data-contrib-id="stheme-ptag-{{id}}"
                data-contrib-name="{{name}}"
                data-contrib-kind="storyThemePowerTag"
                data-contrib-source="Scene"
                data-contrib-tier="">
            <input class="st-theme-tag-inp" type="text"
                   data-theme-id="{{../id}}" data-tag-id="{{id}}" data-collection="powerTags"
                   value="{{name}}" placeholder="power tag…">
          </span>
          {{/each}}
          {{#each weaknessTags}}
          <span class="tag weakness ch-tag {{#if scratched}}scratched{{/if}}"
                data-action="scratchStoryThemeTag"
                data-id="{{../id}}"
                data-tag-id="{{id}}"
                data-collection="weaknessTags"
                data-contrib-id="stheme-wtag-{{id}}"
                data-contrib-name="{{name}}"
                data-contrib-kind="storyThemeWeaknessTag"
                data-contrib-source="Scene"
                data-contrib-tier="">
            <input class="st-theme-tag-inp" type="text"
                   data-theme-id="{{../id}}" data-tag-id="{{id}}" data-collection="weaknessTags"
                   value="{{name}}" placeholder="weakness tag…">
          </span>
          {{/each}}
        </div>
      </div>
      {{/each}}

      {{#if isGM}}
      <span class="tag add edit-only" data-action="addStoryTheme">+ add story theme</span>
      {{/if}}

    </div>

    <!-- RIGHT: Challenges & Journeys -->
    <div class="st-right">

      <div class="csec-title">Challenges &amp; Journeys</div>

      {{#each linked}}
      <div class="st-challenge-card {{#if (eq kind "journey")}}st-journey-card{{/if}} {{#unless visible}}st-hidden{{/unless}}">
        <div class="st-card-hdr">
          <div class="st-card-name">{{actor.name}}</div>
          <div class="st-card-actions">
            <button type="button" class="st-sheet-btn" data-action="openActorSheet"
                    data-actor-id="{{actor.id}}" data-uuid="{{uuid}}" title="Open sheet">
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </button>
            {{#if ../isGM}}
            {{#if (eq kind "challenge")}}
            <button type="button" class="st-eye-btn edit-only" data-action="toggleChallengeLimitsVisibility"
                    data-id="{{id}}" title="{{#if limitsVisible}}Hide limits from players{{else}}Show limits to players{{/if}}">
              <i class="fa-solid fa-shield {{#unless limitsVisible}}st-icon-hidden{{/unless}}"></i>
            </button>
            {{/if}}
            <button type="button" class="st-eye-btn edit-only" data-action="toggleActorVisibility"
                    data-id="{{id}}" data-kind="{{kind}}" title="{{#if visible}}Hide from players{{else}}Show to players{{/if}}">
              <i class="fa-solid {{#if visible}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
            </button>
            <button type="button" class="btn-remove edit-only" data-action="unlinkActor"
                    data-id="{{id}}" data-kind="{{kind}}" data-name="{{actor.name}}" title="Unlink">✕</button>
            {{/if}}
          </div>
        </div>

        {{#if (eq kind "challenge")}}
        {{#if actor.system.role}}
        <div class="st-card-role">{{actor.system.role}}</div>
        {{/if}}
        {{else}}
        {{#if actor.system.journeyType}}
        <div class="st-card-role">{{actor.system.journeyType}}</div>
        {{/if}}
        {{/if}}

        {{#if actor.system.tags.length}}
        <div class="tags-wrap st-card-tags">
          {{#each actor.system.tags}}
          <span class="tag power {{#if scratched}}scratched{{/if}} st-ro-tag"
                data-contrib-id="{{#if (eq ../kind "challenge")}}ctag{{else}}jtag{{/if}}-{{../actor.id}}-{{id}}"
                data-contrib-name="{{name}}"
                data-contrib-kind="{{#if (eq ../kind "challenge")}}challengeTag{{else}}journeyTag{{/if}}"
                data-contrib-tier="" data-contrib-source="{{../actor.name}}">{{name}}</span>
          {{/each}}
        </div>
        {{/if}}

        {{#if (eq kind "challenge")}}
        {{#if showLimits}}
        {{#if actor.system.limits.length}}
        <div class="st-card-limits">
          {{#each actor.system.limits}}
          <span class="st-mini-limit">
            {{#if isImmunity}}
            <i class="fa-solid fa-shield st-lim-icon st-lim-imm"></i>
            {{else}}
            <i class="fa-solid fa-shield st-lim-icon"></i>
            {{/if}}
            <span class="st-lim-name">{{name}}</span>
            {{#unless isImmunity}}<span class="st-lim-max">{{max}}</span>{{/unless}}
          </span>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}

        {{#if actor.system.statuses.length}}
        <div class="st-card-statuses">
          {{#each actor.system.statuses}}
          <span class="st-mini-status"
                data-contrib-id="cstat-{{../actor.id}}-{{id}}" data-contrib-name="{{name}}-{{tier}}" data-contrib-kind="status" data-contrib-tier="{{tier}}" data-contrib-source="{{../actor.name}}">
            <span class="st-mini-name">{{name}}</span>
            <span class="st-mini-tier">{{tier}}</span>
          </span>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}
      </div>
      {{/each}}

      {{#unless linked.length}}
      <div class="chal-empty-note">No challenges or journeys linked.</div>
      {{/unless}}

      {{#if isGM}}
      <p class="chal-drop-hint">Drag a Challenge or Journey actor here to link it.</p>
      {{/if}}

      {{#if isGM}}
      <button type="button" class="chal-add-btn edit-only" data-action="linkActor">+ Link Challenge / Journey</button>
      {{/if}}

    </div>

  </div>

</div>
