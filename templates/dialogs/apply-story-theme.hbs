<div class="litm-apply-dialog-inner">

  <div class="ad-top">
    <select class="ad-main-select">
      <option value="">— select a story theme —</option>
      {{#each allStoryThemes}}
      <option value="{{uuid}}" {{#if (eq uuid ../selectedUuid)}}selected{{/if}}>{{name}}</option>
      {{/each}}
    </select>
  </div>

  <div class="ad-preview">
    {{#if preview}}

    {{#if preview.description}}
    <p class="ad-trope-desc">{{preview.description}}</p>
    {{/if}}

    <p class="ad-hint">Click tags to include them when applying.</p>

    {{#if preview.powerTags.length}}
    <div class="ad-tag-section">
      <div class="ad-section-label">Power Tags</div>
      <div class="ad-tags-wrap">
        {{#each preview.powerTags}}
        <span class="ad-tag power {{#unless on}}off{{/unless}}" data-key="{{key}}">{{name}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if preview.weaknessTags.length}}
    <div class="ad-tag-section">
      <div class="ad-section-label">Weakness Tags</div>
      <div class="ad-tags-wrap">
        {{#each preview.weaknessTags}}
        <span class="ad-tag weakness {{#unless on}}off{{/unless}}" data-key="{{key}}">{{name}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{else}}
    <p class="ad-hint">Select a story theme above to preview its tags.</p>
    {{/if}}
  </div>

  <div class="ad-footer">
    <button type="button" class="ad-cancel-btn">Cancel</button>
    <button type="button" class="ad-apply-btn" {{#unless hasStoryTheme}}disabled{{/unless}}>Apply Story Theme</button>
  </div>

</div>
